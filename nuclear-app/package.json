{
  "name": "nuclear-downloader",
  "version": "0.6.0",
  "description": "Nuclear Downloader is an easy-to-use Windows desktop downloader for YouTube, X, and other yt-dlp-supported sites.",
  "private": true,
  "engines": {
    "node": "22.23.1",
    "npm": "10.9.9"
  },
  "packageManager": "npm@10.9.9",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
    "dev:webdriver": "vite dev --mode webdriver",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e:renderer": "wdio run ./e2e/wdio.browser.conf.mjs",
    "test:e2e:native": "wdio run ./e2e/wdio.native.conf.mjs",
    "test:e2e:production-bundle": "node ./e2e/verify-production-bundle.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "tauri": "tauri"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.4.0",
    "@wdio/cli": "9.31.4",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.31.4",
    "@wdio/mocha-framework": "9.31.2",
    "@wdio/spec-reporter": "9.31.2",
    "@wdio/tauri-service": "1.3.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/svelte": "^5.4.2",
    "eslint": "^10.9.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@wdio/tauri-service": {
      "@wdio/native-utils": "2.6.0"
    }
  }
}
